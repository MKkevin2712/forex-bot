# Copiez ce fichier en .env et remplissez-le. Le fichier .env n'est jamais versionné.

# --- Courtier : oanda ou mt5 ---
BROKER=oanda

# OANDA : compte « practice » (démo), jeton créé dans « Manage API Access »
OANDA_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice

# MetaTrader 5 (Windows) : compte démo de votre courtier, terminal MT5 installé
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# MT5_SYMBOL_SUFFIX=

# --- Marché ---
INSTRUMENTS=EUR_USD,GBP_USD,USD_JPY
GRANULARITY=H4

# --- Risque ---
RISK_PER_TRADE=0.01
MAX_LEVERAGE=10
MAX_OPEN_TRADES=3
DAILY_LOSS_LIMIT=0.03
# TRADING_HOURS_UTC=07-20

# --- Stratégie (valeurs par défaut) ---
# STRATEGY__ATR_STOP_MULT=1.5
# STRATEGY__REWARD_RISK=1.5
# STRATEGY__RSI_LONG_MAX=60
# STRATEGY__RSI_SHORT_MIN=40
# STRATEGY__USE_VOLUME_FILTER=true

# --- Journal : sqlite (local) ou supabase ---
JOURNAL=sqlite
# SUPABASE_URL=
# SUPABASE_KEY=

# --- Bilan quotidien sur Discord (webhook du salon) ---
# DISCORD_WEBHOOK_URL=

# true = analyse sans envoyer d'ordre
DRY_RUN=false
